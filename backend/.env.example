# ============================================
# DATABASE CONFIGURATION
# ============================================
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/ecotech

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5001
NODE_ENV=production

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ============================================
# FILE STORAGE (Cloudinary)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# ML SERVICE - PRODUCTION DEPLOYMENT
# ============================================
# LOCAL DEVELOPMENT:
# ML_SERVICE_URL=http://localhost:8000

# PRODUCTION (Render/AWS/GCP):
# Replace with your deployed ML service URL
ML_SERVICE_URL=https://ecotech-ml.onrender.com

# ============================================
# OPENAI API (for AI-powered suggestions)
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# FRONTEND URLS (for CORS & redirects)
# ============================================
# LOCAL DEVELOPMENT:
# FRONTEND_URL=http://localhost:3000

# PRODUCTION (Vercel):
# Replace with your actual Vercel domain
FRONTEND_URL=https://your-ecotech-domain.vercel.app
